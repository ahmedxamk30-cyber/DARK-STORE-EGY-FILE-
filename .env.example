# Public (safe for browser): project URL and anon key from Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL, used for links (example: https://darkstore.example.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets. Never prefix with NEXT_PUBLIC_ and never import in client components.
# SUPABASE_SERVICE_ROLE_KEY=
